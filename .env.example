# Application
APP_NAME=VaultForge
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string
APP_API_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vaultforge
POSTGRES_PASSWORD=vaultforge
POSTGRES_DB=vaultforge
DATABASE_URL=postgresql+asyncpg://vaultforge:vaultforge@localhost:5432/vaultforge

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery / RabbitMQ
CELERY_BROKER_URL=amqp://vaultforge:vaultforge@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-use-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# OAuth / OIDC
OAUTH_ISSUER_BASE=http://localhost:8000
OAUTH_DEFAULT_CLIENT_ID=vaultforge-web
OAUTH_DEFAULT_CLIENT_SECRET=vaultforge-web-secret
OAUTH_REDIRECT_URIS=http://localhost:3000/oauth/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URIS=http://localhost:3000/oauth/google/callback
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URIS=http://localhost:3000/oauth/microsoft/callback
OAUTH_TOKEN_EXPIRE_MINUTES=60

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_REQUESTS=300
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_OAUTH_REQUESTS=30
RATE_LIMIT_OAUTH_WINDOW=60
RATE_LIMIT_EXPORT_REQUESTS=5
RATE_LIMIT_EXPORT_WINDOW=300
RATE_LIMIT_UPLOAD_REQUESTS=50
RATE_LIMIT_UPLOAD_WINDOW=60

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_UPLOAD_MB=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
